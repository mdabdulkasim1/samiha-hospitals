# ---- Server ----
PORT=3000
NODE_ENV=development
APP_NAME="SAMIHA POLYCLINIC & DIAGNOSTICS"

# 64-char random hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# ---- Database ----
DB_FILE=./data/samiha.db

# ---- Clinic profile (printed on invoices / reports) ----
CLINIC_NAME="SAMIHA POLYCLINIC & DIAGNOSTICS"
CLINIC_ADDRESS="Main Road, Your City"
CLINIC_PHONE="+91 72007 50420"
CLINIC_EMAIL="care@samihapolyclinic.com"
# The number patients message or call — quoted when a chat closes.
CLINIC_WHATSAPP_NUMBER="+91 72007 50420"
CLINIC_GSTIN=""
CURRENCY=INR
CURRENCY_SYMBOL=₹

# ---- Email: password recovery and backup notices ----
# The clinic's central mailbox. Every password-reset link and backup notice is
# copied here, so an account can always be recovered even if the staff member
# no longer has access to their own inbox.
RECOVERY_EMAIL=samihahospital@gmail.com

# Leave MAIL_PROVIDER=mock to run offline — messages are written to the outbox
# instead of being sent, and reset links are shown to the administrator there.
# Set it to smtp with a Gmail App Password (not the account password) to go live:
#   Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_PROVIDER=mock
MAIL_FROM="SAMIHA Healthcare <samihahospital@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=samihahospital@gmail.com
SMTP_PASS=

# Public URL of this app, used to build password-reset links.
APP_URL=http://localhost:3000

# ---- Backups ----
BACKUP_DIR=./data/backups
BACKUP_RETENTION=14
# Daily automatic backup at this hour (0-23, local time). Blank disables it.
BACKUP_HOUR=2
# Attach the backup file to the notice sent to RECOVERY_EMAIL.
BACKUP_EMAIL_ATTACH=false

# ---- Seeding ----
# Create the starter data automatically when the database has no users yet.
# Leave this on for a first deploy, then change every seeded password.
AUTO_SEED=true

# ---- WhatsApp (Meta Cloud API) ----
# Leave WHATSAPP_PROVIDER=mock to run fully offline with the built-in simulator.
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=samiha-verify-token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SESSION_TTL_MINUTES=30
