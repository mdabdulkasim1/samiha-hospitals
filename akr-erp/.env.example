# ---------------------------------------------------------------- server
PORT=4000
NODE_ENV=development
DB_FILE=./data/akr.db
SESSION_SECRET=change-this-before-you-go-live
SESSION_TTL_HOURS=12
# Set to false once the group's own data is loaded, so a wiped database is
# never quietly refilled with the sample catalogue.
AUTO_SEED=true

# ------------------------------------------------------------- the group
GROUP_NAME=AKR GROUP
DEFAULT_COMPANY=AKR

# These are copied onto the default company the first time the database is
# seeded, and on every boot after that they fill in any field the company has
# left blank — so a TRN added here later still reaches the invoices. Anything
# already entered under Masters -> Companies is never overwritten.
COMPANY_NAME=AKR GENERAL TRADING L.L.C
COMPANY_TAGLINE=Trusted Trading Partner for Valves, Fittings & Construction Materials
COMPANY_ADDRESS=206 & 706 Park Avenue Tower, Dubai Silicon Oasis, Dubai, UAE — P.O. Box 19556
COMPANY_PHONE=+971 4 000 0000
COMPANY_EMAIL=sales@akr365.com
COMPANY_WEBSITE=www.akr365.com
# Your Tax Registration Number — fifteen digits. A tax invoice is not valid
# without it, and it is printed at the head of every one.
COMPANY_TRN=105279558800003
# Printed at the foot of a tax invoice, so a client knows where to send the
# money without ringing to ask.
COMPANY_BANK=
COMPANY_ACCOUNT=
COMPANY_IBAN=
COMPANY_SWIFT=

# The company's mark. Drop your own artwork into public/assets (a PNG is fine)
# and point these at it: it then appears on every screen and at the head of and
# behind every printed document. Nothing else in the system names a logo file.
COMPANY_LOGO=/assets/logo-icon.svg
COMPANY_LOGO_FULL=/assets/logo.svg

# The company's own artwork, given to the deployment instead of uploaded to it.
#
# An upload is written beside the database. On a platform with no volume mounted
# that is inside the container it rebuilds on every deploy, so the logo goes in
# on Monday and is the bundled drawing again on Tuesday. These are held by the
# platform, not by the container, so they come back on every start.
#
# Set ONE of them. Neither overwrites artwork somebody has uploaded by hand.
#
#   COMPANY_LOGO_URL   a link to the file. Give the address of the image, or of
#                      a page, and the server looks for the artwork the way a
#                      browser would.
#   COMPANY_LOGO_DATA  the file itself: SVG markup pasted straight in, or base64,
#                      or a data: URI.
#
# COMPANY_LOGO_URL=https://www.akr365.com/logo.png
# COMPANY_LOGO_DATA=<svg xmlns="http://www.w3.org/2000/svg" ...</svg>

# ---------------------------------------------------------------- money
VAT_PERCENT=5
CURRENCY=AED
CURRENCY_SYMBOL=AED
ITEM_CODE_PREFIX=AKR
